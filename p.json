  "accessibility_rules": [
    "هر img محتوایی باید alt مناسب داشته باشد؛ تصویر تزئینی alt خالی داشته باشد.",
    "هر input قابل مشاهده باید label مرتبط داشته باشد.",
    "ساختار heading منطقی باشد و معمولاً یک h1 اصلی وجود داشته باشد.",
    "برای کنترل‌های تعاملی از button یا a واقعی استفاده کن.",
    "برای آیکون بدون متن accessible name فراهم کن.",
    "کنتراست رنگ و focus قابل مشاهده باشد.",
    "از role و aria فقط وقتی معنای بومی HTML کافی نیست استفاده کن.",
    "جدول داده باید caption و header مناسب داشته باشد."
  ],
  "security_rules": [
    "محتوای کاربر را بدون escaping وارد HTML نکن.",
    "برای لینک target=_blank از rel=noopener noreferrer استفاده کن.",
    "از واردکردن اسکریپت ناشناس یا inline event handler پرهیز کن.",
    "CSP را در سطح سرور یا meta با توجه به محدودیت‌ها تنظیم کن؛ meta جایگزین کامل header سرور نیست.",
    "HTML به‌تنهایی احراز هویت یا ذخیره‌سازی امن سمت سرور فراهم نمی‌کند."
  ],
  "responsive_rules": [
    "meta viewport را قرار بده.",
    "از عرض‌های سیال، max-width و CSS Grid/Flexbox استفاده کن.",
    "برای تصویر max-width:100%; height:auto در نظر بگیر.",
    "تعامل لمسی و اندازه کنترل‌ها را در موبایل آزمایش کن.",
    "از اسکرول افقی ناخواسته جلوگیری کن."
  ],
  "best_practices": [
    "از HTML5 و doctype استاندارد استفاده کن.",
    "زبان و جهت صفحه را روی html با lang و dir مشخص کن.",
    "CSS و JavaScript را در فایل‌های جدا یا بخش مناسب نگه دار.",
    "برای script غیرضروری از defer استفاده کن.",
    "برای لینک‌های داخلی متن معنادار بنویس.",
    "برای فرم‌ها method و action متناسب با backend تعریف کن.",
    "HTML را با validator معتبر بررسی کن."
  ],
  "patterns": {
    "basic_document": "<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>عنوان صفحه</title>\n  <meta name=\"description\" content=\"توضیح کوتاه صفحه\">\n</head>\n<body>\n  <header><h1>عنوان اصلی</h1></header>\n  <main><p>محتوای صفحه</p></main>\n  <footer>پاورقی</footer>\n</body>\n</html>",
    "accessible_form": "<form action=\"/submit\" method=\"post\">\n  <label for=\"email\">ایمیل</label>\n  <input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\" required>\n  <button type=\"submit\">ارسال</button>\n</form>",
    "responsive_image": "<img src=\"image.webp\" alt=\"توضیح تصویر\" width=\"1200\" height=\"800\" loading=\"lazy\" decoding=\"async\">",
    "data_table": "<table>\n  <caption>فهرست کاربران</caption>\n  <thead><tr><th scope=\"col\">نام</th><th scope=\"col\">ایمیل</th></tr></thead>\n  <tbody><tr><td>نمونه</td><td>user@example.com</td></tr></tbody>\n</table>"
  }
